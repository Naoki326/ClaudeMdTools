{
  "name": "lanbook",
  "version": "1.3.0",
  "description": "本地知识库 + 课程查看器：直接读取外部文件夹的 .md / HTML 课程，按项目分类，实时更新，在线编辑",
  "main": "server.js",
  "bin": {
    "lanbook": "bin/lanbook.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "server.js",
    "lib/",
    "bin/",
    "public/",
    "knowledge.config.example.json",
    "teach.config.example.json"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "markdown",
    "knowledge-base",
    "lanbook",
    "local-network",
    "course-viewer",
    "express"
  ],
  "author": "zzy <zhiyuan_zheng@roboticplus.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+http://gitlab.roboticplus.com:2022/zzy/ClaudeMdTools.git"
  },
  "type": "commonjs",
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "katex": "^0.16.11",
    "marked": "^17.0.4",
    "marked-katex-extension": "^5.1.10",
    "ws": "^8.19.0"
  }
}
